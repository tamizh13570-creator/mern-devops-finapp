# ==========================================
# FinApp Backend Environment Configuration
# ==========================================
PORT=5000
MONGODB_URI=mongodb://localhost:27017/finapp
JWT_SECRET=super_secret_finapp_jwt_key_2026_finance_tracker
JWT_EXPIRE=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ==========================================
# Email / SMTP Configuration
# NOTE: To send actual emails to real user inboxes:
# 1. Set EMAIL_USER to your real Gmail address (e.g. myname@gmail.com)
# 2. Set EMAIL_PASS to a Google "App Password" (16 letters generated from Google Account > Security > 2-Step Verification > App Passwords)
# If left as demo credentials or empty, FinApp operates in Simulated Mode and provides the OTP directly on screen for instant 1-click verification!
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=demo@finapp.com
EMAIL_PASS=demopassword
